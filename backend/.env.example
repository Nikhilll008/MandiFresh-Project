

# ENVIRONMENT
# development | testing | production
CI_ENVIRONMENT = production

# APP
app.baseURL = 'https://api.mandifresh.in/'


app.forceGlobalSecureRequests = true

# DATABASE — Hostinger MySQL credentials (from hPanel > Databases)
database.default.hostname = localhost
database.default.database = u123456789_mandifresh
database.default.username = u123456789_mfuser
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port     = 3306

# SECURITY / CSRF
security.tokenName        = csrf_token_name
security.headerName       = X-CSRF-TOKEN
security.cookieName       = csrf_cookie_name
security.expires          = 7200
security.regenerate       = true
security.samesite         = Lax

app.allowedOrigins = https://mandifresh.in,https://www.mandifresh.in


logger.threshold = 4
